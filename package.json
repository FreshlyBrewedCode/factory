{
  "name": "factory",
  "private": true,
  "description": "Imperative TypeScript workflows over coding-agent sandboxes, with a dispatch daemon and a monitoring UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreshlyBrewedCode/factory.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "build": "bun scripts/build-release.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt src e2e bin scripts workflows playwright.config.ts components.json package.json tsconfig.json .oxlintrc.json bunfig.toml .releaserc.json",
    "format:check": "oxfmt --check src e2e bin scripts workflows playwright.config.ts components.json package.json tsconfig.json .oxlintrc.json bunfig.toml .releaserc.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-opencode": "^0.4.5",
    "@tanstack/ai-sandbox": "^0.5.7",
    "@tanstack/ai-sandbox-local-process": "^0.2.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.115",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.45.0",
    "@playwright/test": "^1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "25.0.9"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
