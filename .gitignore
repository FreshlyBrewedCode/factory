# factory spike working dir + raw run dumps (D14)
*.ndjson

# ...except the recorded corpora promoted to committed test fixtures. D3's
# event type is designed against the opencode ones (ADR 0003), and the
# corpus-replay adapter reads the ACP ones (`scripts/record-corpus.ts`), so
# they have to survive a fresh checkout.
!test/corpus/*.ndjson

# playwright-cli session snapshots
.playwright-cli/

# factory: regenerable state (the config and workflows above it stay)
**/factory.db
**/factory.db-shm
**/factory.db-wal
.factory/workspaces/
.factory/runs/

# per-machine Tailscale cert for the Vite dev server (`tailscale cert`)
.certs/

spikes/out/
