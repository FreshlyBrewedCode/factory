{
  "name": "@frebreco/factory-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:clean && astro dev",
    "dev:clean": "rm -f .astro/data-store.json node_modules/.astro/data-store.json",
    "build": "astro build && pagefind --site dist",
    "preview": "bun run build && astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/astro": "^1.47.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "pagefind": "^1.5.2",
    "typescript": "^6"
  }
}
